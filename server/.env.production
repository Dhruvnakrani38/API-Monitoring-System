# Production Environment Variables for Oracle Cloud Deployment
# IMPORTANT: Change these values before deploying to production!

# Application Configuration
NODE_ENV=production
PORT=5000

# PostgreSQL Configuration
POSTGRES_DB=api_monitoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dhruv@123
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=api_monitoring
PG_USER=postgres
PG_PASSWORD=dhruv@123

# MongoDB Configuration
MONGO_URI=mongodb://mongo:27017/api_monitoring
MONGO_DB_NAME=api_monitoring

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=api_user
RABBITMQ_DEFAULT_PASS=dhruv@123
RABBITMQ_DEFAULT_VHOST=api_monitoring
RABBITMQ_URL=amqp://api_user:dhruv@123@rabbitmq:5672/api_monitoring
RABBITMQ_QUEUE=api_hits

# JWT Configuration
JWT_SECRET=d65f785253c7e523944114b3499e690ffb049fe18f7dbfbf68891f273d02f19e36f799d4266df480e52c3cec6590f85560c199f79bbd78a38bb313a0446e70a4
JWT_EXPIRES_IN=24h

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=50

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=dhruv@123

# Oracle Cloud Specific Configuration
ORACLE_CLOUD_INSTANCE_ID=
ORACLE_CLOUD_REGION=
ORACLE_CLOUD_AVAILABILITY_DOMAIN=

# Domain Configuration (set these after pointing your domain)
DOMAIN_NAME=
API_DOMAIN=
PGADMIN_DOMAIN=
RABBITMQ_DOMAIN=

# SSL Configuration
SSL_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# Monitoring Configuration
ENABLE_MONITORING=true
MONITORING_ENDPOINT=
LOG_LEVEL=info