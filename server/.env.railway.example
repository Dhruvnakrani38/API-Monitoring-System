# Railway deployment template for API Monitoring System
# Copy these values into Railway -> Variables
# Replace all <...> placeholders with your real service values.

NODE_ENV=production
PORT=5000

JWT_SECRET=<replace_with_a_very_long_random_secret>
JWT_EXPIRES_IN=24h

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>:27017/api_monitoring
MONGO_DB_NAME=api_monitoring

# PostgreSQL
# Use one of these patterns depending on provider:
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>
DATABASE_URL=postgres://<username>:<password>@<host>:5432/api_monitoring
PG_HOST=<host>
PG_PORT=5432
PG_DATABASE=api_monitoring
PG_USER=<username>
PG_PASSWORD=<password>
PG_SSL=true

# RabbitMQ
RABBITMQ_URL=amqp://<username>:<password>@<host>:5672/<vhost>
RABBITMQ_QUEUE=api_hits

# CORS
# Add your frontend URL(s) separated by commas
CORS_ORIGINS=https://your-frontend-domain.com,https://your-railway-app.up.railway.app

# Optional tuning
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
COOKIE_SAME_SITE=lax
